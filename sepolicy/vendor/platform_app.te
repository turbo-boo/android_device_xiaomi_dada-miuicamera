binder_use(platform_app)
binder_call(platform_app, hal_camera_default)
binder_call(platform_app, hal_hypsys_vendor)
binder_call(platform_app, hal_misyscore_default)

allow platform_app hal_aidlbgservice_service:service_manager find;
allow platform_app hal_misys_service:service_manager find;
allow platform_app hal_misyscore_service:service_manager find;

allow platform_app adsprpcd_file:dir { getattr open read search watch };
allow platform_app vendor_miuicamera_dsp_file:dir { getattr open read search watch };

# Match the stock camera policy: p_aivs uses the secure CDSP endpoint, while
# probing the non-secure endpoint first is an expected fallback check.
allow platform_app vendor_xdsp_device:chr_file { ioctl open read };
dontaudit platform_app vendor_qdsp_device:chr_file open;

allow platform_app vendor_camera_data_file:dir { append map r_dir_perms write };
allow platform_app vendor_camera_data_file:file { getattr open read };

allow platform_app app_data_file:file execute;

# MIUI Camera samples PSI data to adapt its workload to system pressure.
allow platform_app proc_pressure_cpu:file r_file_perms;
allow platform_app proc_pressure_io:file r_file_perms;
allow platform_app proc_pressure_mem:file r_file_perms;

# Properties
get_prop(platform_app, vendor_audio_prop)
get_prop(platform_app, vendor_camera_p3enable_prop)
get_prop(platform_app, vendor_camera_sensor_prop)
get_prop(platform_app, vendor_display_prop)
get_prop(platform_app, vendor_displayfeature_prop)
get_prop(platform_app, vendor_panel_info_prop)

Subject: [PATCH 1/3] camera: support dada full-resolution RAW DNG


diff --git a/core/jni/android_hardware_camera2_DngCreator.cpp b/core/jni/android_hardware_camera2_DngCreator.cpp
index f7d4e4cc2..43977f9b4 100644
--- a/core/jni/android_hardware_camera2_DngCreator.cpp
+++ b/core/jni/android_hardware_camera2_DngCreator.cpp
@@ -801,6 +801,33 @@ static int32_t getAppropriateModeTag(int32_t tag, bool maximumResolution) {
     }
 }
 
+// Xiaomi 15 exposes its full-resolution RAW stream through a vendor stream
+// configuration, but its public camera characteristics only describe the
+// binned 4096x3072 array. Keep this fallback device-specific so malformed
+// dimensions from other camera providers are still rejected.
+static bool isDadaFullResolutionRaw(const CameraMetadata& characteristics,
+                                    uint32_t imageWidth, uint32_t imageHeight) {
+    if (GetProperty("ro.product.device", "") != "dada") {
+        return false;
+    }
+
+    camera_metadata_ro_entry pixelArrayEntry =
+            characteristics.find(ANDROID_SENSOR_INFO_PIXEL_ARRAY_SIZE);
+    camera_metadata_ro_entry preCorrectionEntry =
+            characteristics.find(ANDROID_SENSOR_INFO_PRE_CORRECTION_ACTIVE_ARRAY_SIZE);
+    if (pixelArrayEntry.count < 2 || preCorrectionEntry.count < 4) {
+        return false;
+    }
+
+    const uint32_t pixelWidth = static_cast<uint32_t>(pixelArrayEntry.data.i32[0]);
+    const uint32_t pixelHeight = static_cast<uint32_t>(pixelArrayEntry.data.i32[1]);
+    const uint32_t preWidth = static_cast<uint32_t>(preCorrectionEntry.data.i32[2]);
+    const uint32_t preHeight = static_cast<uint32_t>(preCorrectionEntry.data.i32[3]);
+
+    return imageWidth == pixelWidth * 2 && imageHeight == pixelHeight * 2 &&
+            imageWidth == preWidth * 2 && imageHeight == preHeight * 2;
+}
+
